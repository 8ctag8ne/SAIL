# ASPNETCORE_ENVIRONMENT=Development

# Database (Local Postgres)
DB_CONNECTION_LOCAL="Host=localhost;Port=5432;Database=sail_db;Username=postgres;Password=password"

# Database (Supabase / Production)
# DB_CONNECTION_SUPABASE="Host=...;Database=postgres;Username=postgres;Password=...;SSL Mode=Require;Trust Server Certificate=true"
# SUPABASE_SESSION_POOLER="User Id=...;Password=...;Server=...;Port=5432;Database=postgres"

# JWT Settings
JWT__Issuer="http://localhost:5102/"
JWT__Audience="http://localhost:5102/"
JWT__SigningKey="your_super_secret_jwt_key_at_least_64_characters_long"

# Backblaze B2 S3 Storage (Optional in local mode, LocalFileService fallback is used if not provided)
Backblaze__KeyId="your_key_id"
Backblaze__ApplicationKey="your_app_key"
Backblaze__PrivateBucketName="MilLibPrivateSource"
Backblaze__PublicBucketName="MilLibPublicSource"
Backblaze__ServiceUrl="https://s3.eu-central-003.backblazeb2.com"

# Network & AI Integration
AllowedOrigins="http://localhost:3000"
AI_SERVICE_URL="http://localhost:8000"
OLLAMA_API_BASE="http://localhost:11434/v1"

# SMTP / Feedback Email Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_smtp_app_password"
FEEDBACK_RECIPIENT_EMAIL="your_email@gmail.com"
RESEND_API_KEY="your_resend_api_key"
