{
  "mcpServers": {
    "supabase": {
      "command": "zsh",
      "args": [
        "-l",
        "-c",
        "source ~/.zshrc 2>/dev/null; npx -y @supabase/mcp-server-supabase --project-ref \"$SUPABASE_PROJECT_REF\" --access-token \"$SUPABASE_ACCESS_TOKEN\""
      ]
    },
    "supabase-db": {
      "command": "zsh",
      "args": [
        "-l",
        "-c",
        "source ~/.zshrc 2>/dev/null; npx -y @modelcontextprotocol/server-postgres \"$SUPABASE_DB_URL\""
      ]
    },
    "railway": {
      "command": "zsh",
      "args": [
        "-l",
        "-c",
        "source ~/.zshrc 2>/dev/null; RAILWAY_TOKEN=\"$RAILWAY_API_TOKEN\" RAILWAY_API_TOKEN=\"$RAILWAY_API_TOKEN\" npx -y railway-mcp-server"
      ]
    }
  }
}